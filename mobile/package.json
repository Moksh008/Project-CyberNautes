{
  "name": "sentinelai-mobile",
  "version": "0.0.0",
  "private": true,
  "description": "Capacitor mobile shell for the SentinelAI web client",
  "scripts": {
    "build:web": "cross-env VITE_API_BASE_URL=https://project-cybernautes-production.up.railway.app npm --prefix ../client run build",
    "sync": "npm run build:web && cap sync",
    "add:android": "cap add android",
    "add:ios": "cap add ios",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "run:android": "npm run sync && cap run android",
    "run:ios": "npm run sync && cap run ios"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@types/node": "^26.1.1",
    "cross-env": "^7.0.3",
    "typescript": "^7.0.2"
  }
}
